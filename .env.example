# ==============================================================================
# CONFIGURACIÓN DE ENTORNO SIGESP - POLICÍA NACIONAL DEL ECUADOR
# ==============================================================================
ENVIRONMENT=production
APP_NAME="SIGESP - Policia Nacional del Ecuador"
PORT=8083
HOST=0.0.0.0

# Base de Datos PostgreSQL 18 (Aiven Cloud / Render)
DATABASE_URL=postgresql://avnadmin:TU_PASSWORD_AIVEN@sigesp-bd-bd-policia.d.aivencloud.com:15393/policia_nacional?sslmode=require
DB_HOST=sigesp-bd-bd-policia.d.aivencloud.com
DB_PORT=15393
DB_USER=avnadmin
DB_PASS=TU_PASSWORD_AIVEN
DB_NAME=policia_nacional
DB_SSLMODE=require

# Protocolo de Interoperabilidad (5 Grupos UTE-LVT)
INTEROP_API_KEY=RC-POLICIA-KEY-2026

# Seguridad JWT
SECRET_KEY=sigesp-policia-secret-key-2026-seguridad-nacional-esmeraldas-ecuador
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Keycloak SSO (:8080)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=Policia
KEYCLOAK_CLIENT_ID=sigesp-policia
